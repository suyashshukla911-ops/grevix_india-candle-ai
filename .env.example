APP_NAME=India Candle AI
DEFAULT_INTERVAL=60m
TRAIN_DAYS_INTRADAY=60
TRAIN_DAYS_DAILY=900
MIN_TRAIN_ROWS=240
MIN_TRAIN_ROWS_DAILY=45
MIN_SIGNAL_COUNT_DAILY=15
SIGNAL_PRECISION_GATE=0.90
MIN_SIGNAL_COUNT=30
MIN_WILSON_LOWER=0.90
MAX_CACHE_HOURS=24
DATA_TIMEOUT_SECONDS=10
MAX_CANDLES_DISPLAY=120
CHART_CANDLES=48
MODEL_REFRESH_MINUTES=60
CATALOG_REFRESH_HOURS=12
TRANSACTION_COST_BPS=12
SLIPPAGE_BPS=5
MIN_VALUE_TRADED_INR=5000000
MAX_CLONE_MB=150
MAX_CLONES=3
AUTH_ENABLED=true
ADMIN_PASSWORD=change-me
GITHUB_WEBHOOK_SECRET=
MODEL_ARTIFACT_KEY=
REPLAY_ENABLED=true
DEEP_SECURITY_SCAN=true
# On Render Free, keep runtime state under the service filesystem. For durable hosted audit/model state,
# set RUNTIME_DIR to a mounted persistent disk path (for example /var/data) on a paid service.
RUNTIME_DIR=runtime
