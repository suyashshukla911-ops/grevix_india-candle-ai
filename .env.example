# India Candle AI - Upstox + News
APP_NAME=India Candle AI
APP_BASE_URL=http://localhost:8000

# Upstox OAuth
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/upstox/callback

# Optional personal/manual token. OAuth is preferred for the website.
UPSTOX_ACCESS_TOKEN=

# News
NEWS_PROVIDER=gdelt
NEWS_MAX_RECORDS=50

# Model / data
DEFAULT_INTERVAL=5
TRAIN_CALENDAR_DAYS=30
MIN_TRAIN_ROWS=500
WATCH_REFRESH_SECONDS=60
