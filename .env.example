APP_NAME=India Candle AI — TrustGraph
DEFAULT_INTERVAL=60m
TRAIN_DAYS=90
MIN_TRAIN_ROWS=240
SIGNAL_PRECISION_GATE=0.90
MAX_CACHE_HOURS=12
DATA_TIMEOUT_SECONDS=12
MAX_CANDLES_DISPLAY=140
MONITORED_REPOSITORY=workspace/monitored_repository

# Optional production-direction switch. Disabled for competition demo.
DEMO_AUTH_ENABLED=false
DEMO_USERNAME=judge
